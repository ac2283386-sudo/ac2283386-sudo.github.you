<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Caderno Pedagógico de Língua Portuguesa</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .gabarito-highlight {
      border: 2px solid #10B981 !important;
      background-color: #ECFDF5 !important;
      color: #065F46 !important;
    }
    .badge-bncc {
      background-color: #FEF3C7;
      color: #92400E;
      border: 1px solid #F59E0B;
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col">

  <!-- CABEÇALHO -->
  <header class="bg-slate-900 text-white shadow-md sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <div class="bg-indigo-600 p-2.5 rounded-lg shadow-inner">
          <i class="fa-solid fa-graduation-cap text-2xl text-white"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-tight">Caderno Pedagógico de Língua Portuguesa</h1>
          <p class="text-xs text-slate-300">Anos Iniciais do Ensino Fundamental • Atividades Interativas</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <!-- Indicador de Modo -->
        <span id="badge-modo" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-blue-500/20 text-blue-200 border border-blue-400/30 flex items-center gap-1.5">
          <i class="fa-solid fa-user-graduate"></i> Modo Aluno
        </span>

        <!-- Botão Acesso Professor -->
        <button id="btn-toggle-prof" onclick="abrirModalOuSair()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1.5 rounded-lg border border-slate-600 transition flex items-center gap-1.5">
          <i class="fa-solid fa-lock text-amber-400"></i> Área do Professor
        </button>
      </div>
    </div>
  </header>

  <!-- BANNER PROFESSOR (Visível apenas se autenticado) -->
  <div id="banner-prof" class="hidden bg-amber-500 text-slate-950 px-4 py-2 border-b border-amber-600 shadow-inner">
    <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between text-xs font-medium gap-2">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-eye text-base"></i>
        <span><strong>MODO PROFESSOR ATIVO:</strong> Gabaritos, notas da BNCC e preenchimento automático ativados.</span>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="preencherTudo()" class="bg-slate-900 text-white px-2.5 py-1 rounded hover:bg-slate-800 transition">
          <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Preencher Respostas
        </button>
        <button onclick="bloquearModoProf()" class="bg-red-700 text-white px-2.5 py-1 rounded hover:bg-red-800 transition">
          <i class="fa-solid fa-right-from-bracket mr-1"></i> Sair do Modo Prof
        </button>
      </div>
    </div>
  </div>

  <!-- TELA DE ENTRADA DO ALUNO (SÓ EMAIL) -->
  <div id="tela-login" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-slate-200">
      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
          <i class="fa-solid fa-book-open-reader"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-800">Bem-vindo às Atividades!</h2>
        <p class="text-sm text-slate-500 mt-1">Informe seu e-mail abaixo para iniciar o caderno pedagógico.</p>
      </div>function iniciarSessaoAluno(event) {
    event.preventDefault();
    const email = document.getElementById('input-email-aluno').value;
    if (email) {
        emailAluno = email;
        document.getElementById('tela-login').classList.add('hidden');
    }
}
function iniciarSessaoAluno(event) {
    event.preventDefault();
    const email = document.getElementById('input-email-aluno').value;
    if (email) {
        emailAluno = email;
        document.getElementById('tela-login').classList.add('hidden');
    }
}


      <form onsubmit="iniciarSessaoAluno(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Seu E-mail:</label>
          <input type="email" id="input-email-aluno" required placeholder="exemplo@escola.com" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg shadow-md transition text-sm flex items-center justify-center gap-2">
          <span>Iniciar Atividades</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>
    </div>
  </div>

  <!-- MODAL DE SENHA PROFESSOR -->
  <div id="modal-senha" class="hidden fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl border border-slate-200">
      <div class="text-center mb-4">
        <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-2 text-xl">
          <i class="fa-solid fa-key"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800">Acesso Docente</h3>
        <p class="text-xs text-slate-500 mt-0.5">Digite a senha para visualizar gabaritos e notas pedagógicas.</p>
      </div>

      <form onsubmit="validarSenhaProf(event)" class="space-y-3">
        <div>
          <input type="password" id="input-senha-prof" required placeholder="Digite a senha" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
          <p id="msg-erro-senha" class="hidden text-xs text-red-500 mt-1 font-medium">Senha incorreta. Tente novamente.</p>
        </div>
        <div class="flex gap-2">
          <button type="button" onclick="fecharModalSenha()" class="w-1/2 bg-slate-200 hover:bg-slate-300 text-slate-700 py-2 rounded-lg text-xs font-semibold">Cancelar</button>
          <button type="submit" class="w-1/2 bg-amber-500 hover:bg-amber-600 text-slate-950 py-2 rounded-lg text-xs font-semibold">Entrar</button>
        </div>
      </form>
      <p class="text-[10px] text-slate-400 text-center mt-3">Senha padrão de demonstração: <strong>prof123</strong></p>
    </div>
  </div>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="flex-grow max-w-5xl w-full mx-auto p-4 space-y-6">

    <!-- BARRA DE NAVEGAÇÃO DE MÓDULOS -->
    <div class="bg-white rounded-xl p-2 shadow-sm border border-slate-200 flex overflow-x-auto gap-2">
      <button onclick="mudarModulo(1)" id="btn-mod-1" class="mod-btn active px-4 py-2 rounded-lg text-xs font-semibold whitespace-nowrap bg-indigo-600 text-white shadow-sm transition">
        1. Formação de Palavras
      </button>
      <button onclick="mudarModulo(2)" id="btn-mod-2" class="mod-btn px-4 py-2 rounded-lg text-xs font-semibold whitespace-nowrap text-slate-600 hover:bg-slate-100 transition">
        2. Separação Silábica
      </button>
      <button onclick="mudarModulo(3)" id="btn-mod-3" class="mod-btn px-4 py-2 rounded-lg text-xs font-semibold whitespace-nowrap text-slate-600 hover:bg-slate-100 transition">
        3. Ordenação de Frases
      </button>
      <button onclick="mudarModulo(4)" id="btn-mod-4" class="mod-btn px-4 py-2 rounded-lg text-xs font-semibold whitespace-nowrap text-slate-600 hover:bg-slate-100 transition">
        4. Classificação Gramatical
      </button>
    </div>

    <!-- CARDS DOS MÓDULOS -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">

      <!-- MÓDULO 1: SILABAS -->
      <section id="modulo-1" class="space-y-6">
        <div class="border-b pb-4">
          <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Módulo 1</span>
          <h2 class="text-xl font-bold text-slate-800">Formação e Síntese Silábica</h2>
          <p class="text-xs text-slate-500 mt-1">Clique nas sílabas do banco para montar a palavra correspondente à dica.</p>
        </div>

        <div class="nota-bncc hidden bg-amber-50 rounded-lg p-3 border border-amber-200 text-xs text-amber-900">
          <strong><i class="fa-solid fa-bookmark mr-1"></i> BNCC (EF01LP06):</strong> Desenvolve a consciência fonológica e a síntese silábica na formação de vocábulos do cotidiano escolar.
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
          <div class="bg-white p-3 rounded-lg border border-slate-200">
            <span class="text-xs text-slate-400 font-bold block mb-1">CONCEITO / DICA:</span>
            <p id="dica-mod1" class="text-sm font-medium text-slate-700">"Objeto utilizado para escrever ou desenhar no caderno."</p>
          </div>

          <!-- Quadro de Montagem -->
          <div>
            <span class="text-xs text-slate-500 font-semibold block mb-2">Sua construção (Clique nas sílabas abaixo):</span>
            <div id="construcao-silabas" class="flex flex-wrap gap-2 min-h-[50px] p-2 bg-white rounded-lg border-2 border-dashed border-slate-300 items-center">
              <span class="text-xs text-slate-400 italic font-normal" id="placeholder-silabas">Nenhuma sílaba selecionada...</span>
            </div>
          </div>

          <!-- Banco de Sílabas -->
          <div>
            <span class="text-xs text-slate-500 font-semibold block mb-2">Banco de Sílabas disponíveis:</span>
            <div id="banco-silabas" class="flex flex-wrap gap-2">
              <!-- Inseridas via JS -->
            </div>
          </div>

          <!-- Resposta do Professor -->
          <div id="gabarito-mod1" class="hidden text-xs bg-emerald-100 text-emerald-800 p-3 rounded-lg font-medium border border-emerald-300">
            <i class="fa-solid fa-check-circle mr-1"></i> <strong>Gabarito do Professor:</strong> LÁ - PIS (Lápis)
          </div>
        </div>
      </section>

      <!-- MÓDULO 2: SEPARAÇÃO SILÁBICA -->
      <section id="modulo-2" class="hidden space-y-6">
        <div class="border-b pb-4">
          <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Módulo 2</span>
          <h2 class="text-xl font-bold text-slate-800">Separação e Classificação Silábica</h2>
          <p class="text-xs text-slate-500 mt-1">Clique para separar a palavra em sílabas e depois selecione sua classificação.</p>
        </div>

        <div class="nota-bncc hidden bg-amber-50 rounded-lg p-3 border border-amber-200 text-xs text-amber-900">
          <strong><i class="fa-solid fa-bookmark mr-1"></i> BNCC (EF02LP04):</strong> Segmentação de palavras em sílabas e classificação quanto ao número de sílabas.
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
          <div class="text-center py-2">
            <span class="text-xs text-slate-400 font-bold block">PALAVRA EM ESTUDO:</span>
            <span class="text-2xl font-extrabold text-indigo-700 tracking-wider">BORBOLETA</span>
          </div>

          <!-- Divisão -->
          <div>
            <span class="text-xs text-slate-500 font-semibold block mb-2">1. Clique nos pontos de corte para separar:</span>
            <div id="container-separacao" class="flex items-center justify-center gap-1 bg-white p-4 rounded-lg border border-slate-200">
              <!-- Gerado via JS -->
            </div>
          </div>

          <!-- Classificação -->
          <div>
            <span class="text-xs text-slate-500 font-semibold block mb-2">2. Classificação quanto ao número de sílabas:</span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="opcoes-classificacao">
              <button onclick="selecionarClassificacao('Monossílaba')" class="btn-classif p-2.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">Monossílaba (1)</button>
              <button onclick="selecionarClassificacao('Dissílaba')" class="btn-classif p-2.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">Dissílaba (2)</button>
              <button onclick="selecionarClassificacao('Trissílaba')" class="btn-classif p-2.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">Trissílaba (3)</button>
              <button onclick="selecionarClassificacao('Polissílaba')" class="btn-classif p-2.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">Polissílaba (4+)</button>
            </div>
          </div>

          <div id="gabarito-mod2" class="hidden text-xs bg-emerald-100 text-emerald-800 p-3 rounded-lg font-medium border border-emerald-300">
            <i class="fa-solid fa-check-circle mr-1"></i> <strong>Gabarito do Professor:</strong> BOR - BO - LE - TA (4 sílabas = Polissílaba)
          </div>
        </div>
      </section>

      <!-- MÓDULO 3: ORDENAÇÃO DE FRASES -->
      <section id="modulo-3" class="hidden space-y-6">
        <div class="border-b pb-4">
          <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Módulo 3</span>
          <h2 class="text-xl font-bold text-slate-800">Sintaxe e Ordenação de Frases</h2>
          <p class="text-xs text-slate-500 mt-1">Clique nas palavras fora de ordem para organizar a frase com sentido gramatical.</p>
        </div>

        <div class="nota-bncc hidden bg-amber-50 rounded-lg p-3 border border-amber-200 text-xs text-amber-900">
          <strong><i class="fa-solid fa-bookmark mr-1"></i> BNCC (EF03LP07):</strong> Estruturação de orações observando a concordância verbal e nominal.
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
          <div>
            <span class="text-xs text-slate-500 font-semibold block mb-2">Frase em construção:</span>
            <div id="linha-frase" class="min-h-[50px] p-3 bg-white rounded-lg border-2 border-dashed border-slate-300 flex flex-wrap gap-2 items-center">
              <span id="placeholder-frase" class="text-xs text-slate-400 italic">Clique nas palavras abaixo para montar...</span>
            </div>
          </div>

          <div>
            <span class="text-xs text-slate-500 font-semibold block mb-2">Palavras disponíveis:</span>
            <div id="banco-palavras-frase" class="flex flex-wrap gap-2">
              <!-- Gerado via JS -->
            </div>
          </div>

          <div id="gabarito-mod3" class="hidden text-xs bg-emerald-100 text-emerald-800 p-3 rounded-lg font-medium border border-emerald-300">
            <i class="fa-solid fa-check-circle mr-1"></i> <strong>Gabarito do Professor:</strong> "O aluno estudou para a prova de Português."
          </div>
        </div>
      </section>

      <!-- MÓDULO 4: CLASSIFICAÇÃO GRAMATICAL -->
      <section id="modulo-4" class="hidden space-y-6">
        <div class="border-b pb-4">
          <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Módulo 4</span>
          <h2 class="text-xl font-bold text-slate-800">Classificação Gramatical (Substantivo vs. Adjetivo)</h2>
          <p class="text-xs text-slate-500 mt-1">Clique na palavra e depois clique na caixa correspondente para classificá-la.</p>
        </div>

        <div class="nota-bncc hidden bg-amber-50 rounded-lg p-3 border border-amber-200 text-xs text-amber-900">
          <strong><i class="fa-solid fa-bookmark mr-1"></i> BNCC (EF03LP08):</strong> Identificação e diferenciação de classes gramaticais em contexto.
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
          <div>
            <span class="text-xs text-slate-500 font-semibold block mb-2">Palavras para classificar:</span>
            <div id="banco-gramatica" class="flex flex-wrap gap-2">
              <!-- Gerado JS -->
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <!-- Caixa Substantivos -->
            <div class="bg-white p-4 rounded-xl border border-blue-200 shadow-sm">
              <div class="flex items-center gap-2 mb-3 text-blue-700 font-bold text-sm border-b pb-2">
                <i class="fa-solid fa-box"></i>
                <span>SUBSTANTIVOS (Nomeiam seres e objetos)</span>
              </div>
              <div id="box-substantivos" class="min-h-[80px] flex flex-wrap gap-1.5 p-2 bg-blue-50/50 rounded-lg border border-blue-100"></div>
            </div>

            <!-- Caixa Adjetivos -->
            <div class="bg-white p-4 rounded-xl border border-emerald-200 shadow-sm">
              <div class="flex items-center gap-2 mb-3 text-emerald-700 font-bold text-sm border-b pb-2">
                <i class="fa-solid fa-tags"></i>
                <span>ADJETIVOS (Características e qualidades)</span>
              </div>
              <div id="box-adjetivos" class="min-h-[80px] flex flex-wrap gap-1.5 p-2 bg-emerald-50/50 rounded-lg border border-emerald-100"></div>
            </div>
          </div>

          <div id="gabarito-mod4" class="hidden text-xs bg-emerald-100 text-emerald-800 p-3 rounded-lg font-medium border border-emerald-300">
            <i class="fa-solid fa-check-circle mr-1"></i> <strong>Gabarito do Professor:</strong><br>
            • Substantivos: Menino, Livro, Escola<br>
            • Adjetivos: Inteligente, Novo, Grande
          </div>
        </div>
      </section>

      <!-- BOTOES DE AÇÃO -->
      <div class="mt-8 pt-4 border-t border-slate-200 flex flex-wrap justify-between items-center gap-3">
        <button onclick="limparModuloAtual()" class="text-xs text-slate-500 hover:text-slate-800 font-semibold flex items-center gap-1 px-3 py-2 rounded-lg hover:bg-slate-100 transition">
          <i class="fa-solid fa-rotate-left"></i> Reiniciar este módulo
        </button>

        <button onclick="finalizarEEnviar()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-lg text-xs shadow-md transition flex items-center gap-2">
          <i class="fa-solid fa-paper-plane"></i> Finalizar e Enviar para o Professor
        </button>
      </div>

    </div>
  </main>

  <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-400 mt-auto">
    Portal Pedagógico de Língua Portuguesa • Envio automático para <strong>ac2283386@gmail.com</strong>
  </footer>

  <!-- JAVASCRIPT -->
  <script>
    let emailAluno = "";
    let modoProfessorAtivo = false;
    const SENHA_MESTRE = "prof123";

    // Dados das atividades
    const silabasDisponiveis = ["LÁ", "PIS", "CA", "DE", "NO", "BO"];
    const palavraSilabasGabarito = ["LÁ", "PIS"];
    let silabasSelecionadas = [];

    const palavraSeparacao = ["BOR", "BO", "LE", "TA"];
    let cortessilabas = [false, false, false]; // entre cada sílaba
    let classificacaoEscolhida = "";

    const palavrasFrase = ["estudou", "O", "aluno", "Português.", "para", "a", "prova", "de"];
    const fraseGabarito = ["O", "aluno", "estudou", "para", "a", "prova", "de", "Português."];
    let fraseConstruida = [];

    const palavrasGramatica = [
      { id: 1, texto: "Menino", tipo: "substantivo" },
      { id: 2, texto: "Inteligente", tipo: "adjetivo" },
      { id: 3, texto: "Livro", tipo: "substantivo" },
      { id: 4, texto: "Novo", tipo: "adjetivo" },
      { id: 5, texto: "Escola", tipo: "substantivo" },
      { id: 6, texto: "Grande", tipo: "adjetivo" }
    ];
    let gramaticaClassificada = {}; // id -> 'substantivo' | 'adjetivo'
    let palavraGramaticaSelecionada = null;

    // INICIALIZAÇÃO
    window.onload = () => {
      renderizarModulo1();
      render
